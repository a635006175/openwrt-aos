#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1
START=95
STOP=10

start_service() {
	mkdir -p /var/run/console-vpn
	if [ -x /usr/sbin/openvpn ] && [ -r /etc/console-vpn/server.enabled ] && [ -r /etc/console-vpn/server.conf ] && [ -r /etc/console-vpn/pki/private/server.key ]; then
		procd_open_instance server
		procd_set_param command /usr/sbin/openvpn --config /etc/console-vpn/server.conf
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
	# 客户端：证书认证的导入配置没有 auth 文件，此时要求内嵌客户端证书与私钥。
	if [ -x /usr/sbin/openvpn ] && [ -r /etc/console-vpn/client.enabled ] && [ -r /etc/console-vpn/client/client.conf ] && [ -r /etc/console-vpn/client/ca.crt ] \
		&& { [ -r /etc/console-vpn/client/auth ] || { [ -r /etc/console-vpn/client/client.crt ] && [ -r /etc/console-vpn/client/client.key ]; }; }; then
		procd_open_instance client
		procd_set_param command /usr/sbin/openvpn --config /etc/console-vpn/client/client.conf
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
