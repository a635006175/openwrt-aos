#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=97
STOP=12
USE_PROCD=1

# 流控分流开机恢复：重建 inet console_flow 表、线路 ip rule 与路由表。
# 顺序说明：START=97 排在 firewall(19)/网络(20)之后、rpcd 之前，确保 fw4 已经把
# NAT hook 装好；本表只在自己的 hook 优先级上工作，不修改 fw4 的任何规则。
#
# 注意：rpcd 会长期缓存 ucode 模块，升级 flow*.uc 之后必须重启 rpcd 才生效
# （与 console-security 相同的坑）。不要在这里重启 rpcd，交给 postinst/升级流程。

start_service() {
	mkdir -p /etc/console-flow
	chmod 700 /etc/console-flow
	# 恢复生效态；无配置或 disabled 时只做清理（不建表）。
	/usr/bin/ucode /usr/sbin/console-flow-control.uc init >/tmp/console-flow-init.log 2>&1
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/console-flow-daemon.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 精确清理：只删 inet console_flow 表、prio 10400..10499 的 ip rule、table 300..319。
	/usr/bin/ucode /usr/sbin/console-flow-control.uc stop >/tmp/console-flow-stop.log 2>&1
}

reload_service() {
	/usr/bin/ucode /usr/sbin/console-flow-control.uc refresh >/tmp/console-flow-reload.log 2>&1
}

service_triggers() {
	procd_add_reload_trigger 'network'
}
