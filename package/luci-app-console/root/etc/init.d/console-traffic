#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	mkdir -p /srv/console-history
	chmod 700 /srv/console-history
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/console-traffic.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
