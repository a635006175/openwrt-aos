#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=96
STOP=10
USE_PROCD=1

# rpcd 会把 ucode 模块加载进进程并长期缓存。升级替换 situational.uc / security.uc
# 之后如果 rpcd 不重启，它会继续执行旧 inode 里的旧代码 —— 表现为「数据库里明明
# 有拦截记录，页面却全是 0」，而且没有任何报错，极难排查（实际踩过好几次）。
#
# 但**不要在这里重启 rpcd**：uhttpd/rpcd 自身依赖 ubus，在服务启动过程中
# 去重启它会造成进程竞态（实测出现多个 rpcd 并存），还会拖住调用方的 ubus 会话。
# 正确做法是交给升级脚本（postinst）在装完之后单独重启一次，见 README。
start_service() {
	mkdir -p /etc/console-security /srv/console-security /usr/share/nftables.d/ruleset-post
	chmod 700 /etc/console-security /srv/console-security
	/usr/bin/ucode /usr/sbin/console-security-control.uc init || return 1
	ln -snf /etc/console-security/guard.nft /usr/share/nftables.d/ruleset-post/90-console-guard.nft
	mkdir -p /etc/console-situational /srv/console-situational
	chmod 700 /etc/console-situational /srv/console-situational
	# Do not let the background downloader inherit procd's service flock.
	/usr/bin/ucode /usr/sbin/console-threat-update.uc 1000>&- >/tmp/console-threat-init.log 2>&1 &
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/console-security-collector.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
reload_service() { /usr/bin/ucode /usr/sbin/console-security-control.uc init; }
